# Ensure PowerShell scripts keep consistent Windows CRLF line endings
*.ps1 text eol=crlf

# Source and documentation files default to LF
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
